@startuml seq-signin
' UC1 Sign In with GitHub (device flow).
' Every message is the real C function name. Replaces the Meeting 2 web
' redirect flow, which had no equivalent in a terminal application.

skinparam backgroundColor white
skinparam sequence {
  ParticipantBackgroundColor #AEDCF0
  ParticipantBorderColor #333333
  LifeLineBorderColor #333333
}

actor User
participant "menu.c" as menu
participant "core/github_service.c" as svc
participant "github.c" as gh
participant "json.c" as json
participant "token_store.c" as tok
participant "db.c" as db
participant "auth_ctx.c" as auth
participant "GitHub Server" as server

User -> menu : select "4) GitHub login"
activate menu
menu -> menu : github_login()

menu -> svc : github_service_login_start(&prompt)
activate svc
svc -> gh : github_device_start(&dev)
activate gh
gh -> server : http_post_form(\n  "github.com/login/device/code")
server --> gh : device_code, user_code,\nverification_uri, interval
gh -> json : json_field() / json_field_int()
json --> gh : parsed fields
gh --> svc : GH_OK
deactivate gh
svc --> menu : GH_SVC_OK, prompt
deactivate svc

menu -> User : display prompt.verification_uri\nand prompt.user_code
User -> server : authorize device in browser

menu -> svc : github_service_login_wait(&token_saved)
activate svc

loop until GH_OK or terminal error (max GH_MAX_POLLS = 180)
  svc -> gh : github_device_poll(device_code, token, n)
  activate gh
  gh -> server : http_post_form(\n  "github.com/login/oauth/access_token")
  server --> gh : response body
  gh -> gh : github_parse_token_response(body, token, n)
  gh -> json : json_field()
  json --> gh : access_token or error
  gh --> svc : GH_OK | GH_PENDING | GH_SLOW_DOWN\n| GH_EXPIRED | GH_DENIED
  deactivate gh
end

alt GH_OK
  svc -> tok : token_save(token)
  activate tok
  tok --> svc : true (file written with mode 0600)
  deactivate tok

  svc -> gh : github_fetch_user(token, &profile, &rejected)
  activate gh
  gh -> server : http_get_bearer("api.github.com/user")
  server --> gh : id, login, name, avatar_url
  gh -> json : json_field_int() / json_field()
  json --> gh : parsed profile
  gh --> svc : true
  deactivate gh

  svc -> db : db_user_upsert_github(profile.id, profile.login,\n  profile.display_name, profile.avatar_url, &user)
  activate db
  db -> db : db_user_find_by_github_id(github_id)
  alt github_id already known
    db -> db : UPDATE users
  else first sign in
    db -> db : id_generate() then INSERT users
  end
  db --> svc : true
  deactivate db

  svc -> auth : auth_ctx_set_user(user.id)
  svc --> menu : GH_SVC_OK
  menu -> User : "signed in as <username>"

else GH_EXPIRED or GH_DENIED
  svc --> menu : GH_SVC_EXPIRED | GH_SVC_DENIED
  menu -> User : report failure, token not saved
end

deactivate svc
deactivate menu

note over menu, auth
  At startup github_resume_session() calls
  github_service_resume(), which runs the same
  token_load() then github_fetch_user() then
  db_user_upsert_github() then auth_ctx_set_user()
  tail. With no usable token it falls back to
  use_local_identity(): db_user_find_local("local"),
  creating the row with db_user_create() if it is not
  there yet, then auth_ctx_set_user(local.id). Either
  way the session ends up pointed at a real row in
  users, never a bare string.
end note

@enduml
